{
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "test-results/**",
    "public/mockServiceWorker.js",
    // drizzle-kit's output: the SQL and its snapshots are regenerated, never
    // edited, and a formatter pass would only diff against the next run.
    "server/migrations/**",
    // Prose the agents read, not code: the skill tables are aligned by hand
    // and re-padding them on every edit is churn with no reader.
    ".claude/**",
    // The /teach workspace: generated lessons, kept as they were produced.
    "docs/course/**"
  ]
}
