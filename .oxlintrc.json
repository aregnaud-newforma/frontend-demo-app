{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Setting `plugins` REPLACES the default set, so this list is the whole set.
  // react-perf is deliberately absent: it flags every inline handler and every
  // `style={{...}}`, which is exactly what babel-plugin-react-compiler exists to
  // memoize (see vite.config.ts). A linter arguing with the compiler is noise.
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "promise"],

  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },

  // The same floor as tsconfig `lib` and package.json `browserslist`: es2024
  // here told the linter globals exist that the shipped browsers do not have.
  "env": { "browser": true, "es2023": true },

  "rules": {
    // The automatic JSX runtime ("jsx": "react-jsx" in tsconfig.json) means no
    // component imports React, and this rule predates it.
    "react/react-in-jsx-scope": "off",

    // Would have us write the loading message as <output> because that tag
    // carries role="status" implicitly. It does - but <output> is defined as the
    // result of a calculation, and "Loading your account..." is not one. The
    // role is on a <p> on purpose; the a11y outcome is identical.
    "jsx-a11y/prefer-tag-over-role": "off"
  },

  "ignorePatterns": [
    "node_modules",
    // Every app writes into its own dist/ now, so the pattern has to match at
    // any depth rather than only at the root.
    "**/dist",
    ".turbo",
    "apps/shell/public/mockServiceWorker.js",
    "test-results",
    "playwright-report"
  ],

  "overrides": [
    {
      // Vitest's own rules, only where tests live. `expect-expect` is the one
      // that earns its place here: a test that drives the app and asserts
      // nothing passes silently, which is the failure this repo's whole point
      // depends on not happening.
      "files": ["**/__tests__/**", "e2e/**", "vitest.setup.ts"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/expect-expect": "error",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "warn",
        "vitest/no-identical-title": "error",
        "vitest/valid-expect": "error",

        // vitest.setup.ts imports vitest-browser-react purely for its side
        // effects, which is the documented way to install it.
        "import/no-unassigned-import": "off"
      }
    },
    {
      // `/// <reference types="vitest/config" />` is how vitest.config.ts gets
      // its types; there is no import form of it.
      "files": ["*.config.ts"],
      "rules": { "typescript/triple-slash-reference": "off" }
    },
    {
      // The entry point imports global.css for its side effect - that IS how a
      // stylesheet is pulled into a bundle, and there is nothing to assign it
      // to. Same exemption as vitest.setup.ts above, for the same reason. A
      // remote's exposed modules (apps/<vertical>/src/pages.ts, preview.ts) are
      // the entry points of ITS build, and pull its stylesheet in the same way.
      "files": ["apps/shell/src/main.tsx", "apps/*/src/pages.ts", "apps/*/src/preview.ts"],
      "rules": { "import/no-unassigned-import": "off" }
    },
    {
      // React Native, where three of the rules above are reasoning about a
      // platform this app does not run on.
      //
      // jsx-a11y reads JSX element NAMES - it knows what an <img> or a <button>
      // needs, and a <Pressable> means nothing to it, so every rule in it is
      // either silent or wrong here. Accessibility is not dropped with it: the
      // components carry `accessibilityRole`, `accessibilityLabel` and
      // `accessibilityLiveRegion`, and the *.native.test.tsx suite queries by
      // label rather than by test id, which is the check a linter cannot make.
      //
      // The two unassigned imports are the app's entry point and its jest
      // setup, both of which exist ONLY for their side effects and in an order
      // that matters - each file says why.
      //
      // `no-unstable-nested-components` is the one real trade: a native screen
      // declares its header button as `headerRight: () => ...`, which is the
      // navigator's API rather than a component tree, so there is no version of
      // it the rule would accept.
      "files": ["apps/mobile/**"],
      "plugins": ["typescript", "unicorn", "oxc", "react", "import", "promise"],
      "rules": {
        "import/no-unassigned-import": "off",
        "react/no-unstable-nested-components": "off"
      }
    }
  ]
}
