# Dependencies
node_modules/

# Build output
dist/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Vitest Browser Mode. Screenshots on failure are off by choice (see
# vitest.config.ts), but the runner still writes attachments when it has any.
__screenshots__/
.vitest-attachments/

# Coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# Local env files. None are used today; here so the first one added is not
# committed by accident.
.env
.env.*
!.env.example

# Editor / OS
# .vscode is deliberately NOT ignored: settings.json pins the oxfmt formatter
# and extensions.json recommends the Oxc extension, both of which are part of
# how this repo is meant to be used.
.idea/
*.swp
.DS_Store

# Local teaching workspace, not part of the app
docs/course/

# Captured eval trial outcomes: large, machine-written, and re-creatable by a run.
evals/.runs/

# The suite's clone of the repository that holds the rules under test, named by
# `evals/skills.pin.json`. A checkout of somebody else's repository is build
# output: re-creatable, and not this repository's to version.
evals/.skills/

# The eval suite's answer key. It maps each rule to what checks it, which states
# in one line what a task is graded on — no hand-written `useMemo`, `Set` methods
# need ES2025. A trial's worktree is a checkout of HEAD, so a tracked copy would
# sit in front of the agent being measured, in both arms at once: not a
# difference between them, but a floor raised under both that flattens the delta
# the suite exists to measure. Untracked, it stays readable by whoever is writing
# the tasks and invisible to whoever is being asked to answer them.
docs/lint-coverage.md
