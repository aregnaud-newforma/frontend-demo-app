# Dependencies
node_modules/

# Build output
dist/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Vitest Browser Mode. Screenshots on failure are off by choice (see
# vitest.config.ts), but the runner still writes attachments when it has any.
__screenshots__/
.vitest-attachments/

# Lighthouse CI's runs and reports, written by `yarn lighthouse`.
.lighthouseci/

# The Synthetics private location's config, downloaded from Datadog when the
# location is created (synthetics/README.md). It holds the worker's secret keys.
synthetics/.private-location.json

# Coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# Local env files. None are used today; here so the first one added is not
# committed by accident.
.env
.env.*
!.env.example

# Editor / OS
# .vscode is deliberately NOT ignored: settings.json pins the oxfmt formatter
# and extensions.json recommends the Oxc extension, both of which are part of
# how this repo is meant to be used.
.idea/
*.swp
.DS_Store

# Local teaching workspace, not part of the app
docs/course/

# A local working note, not part of the app.
docs/lint-coverage.md

# .NET build output (server/)
bin/
obj/

# Turborepo's task cache. Also kept OUT of every task's inputs by being
# ignored: a root task hashes the whole root package, so a cache directory
# inside it would change the hash on every run and never hit.
.turbo/
