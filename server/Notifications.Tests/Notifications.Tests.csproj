<!-- The notifications service's own tests: xunit, in process, against nothing.
     `yarn server:test` runs them with the account API's, through the solution.

     No Testcontainers here, unlike ../Accounts.Tests: this service has no database
     to start (../Notifications/Outbox.cs says why), and the piece worth testing
     is a pure function. What the wiring around it does is the E2E tier's job -
     ../../e2e/account.spec.ts reads a notification back out of the running
     process, which is the only place the hop between the two services is real. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>Notifications.Tests</RootNamespace>
    <!-- xunit.v3 as a Microsoft.Testing.Platform app, which is the runner
         ../../global.json tells `dotnet test` to use: SDK 10 still defaults to
         VSTest, and xunit.v3 no longer answers to that one. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Notifications/Notifications.csproj" />
  </ItemGroup>

</Project>
