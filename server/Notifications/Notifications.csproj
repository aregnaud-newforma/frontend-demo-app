<!--
  The notifications service: ASP.NET Core minimal APIs, no database, see
  Program.cs for what it serves and docs/adr/0004 for why the backend is two
  processes rather than one.

  The SDK version is pinned in ../../global.json, the same file ../Accounts/Accounts.csproj
  points at. The Sentry packages are NOT here: they come with
  ../Observability/Observability.csproj, which is where the setup both services
  share lives.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The same bar as `tsc` with `noEmit` under `strict`: a warning is a failure. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- No culture-aware formatting anywhere in this service, so no ICU to ship.
         The French and English message bodies are literal strings, not a
         culture's rendering of anything - see Messages.cs. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Notifications</RootNamespace>
  </PropertyGroup>

  <!-- Its own Sentry project, on the same terms as ../Accounts/Accounts.csproj - read
       that file for what each of these properties does and why
       `SentryUploadSources` is not one of them. The project name is the only
       line that differs, and it is the line that puts a .NET stack from THIS
       service in its own issue stream. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(SENTRY_AUTH_TOKEN)' != ''">
    <SentryOrg>alexisregnaud</SentryOrg>
    <!-- This service's own project, as in .env.example and Program.cs. -->
    <SentryProject>frontend-demo-notifications</SentryProject>
    <SentryUploadSymbols>true</SentryUploadSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the repo's .env into the process, the same way ../Accounts does: one
         file holds the DSNs and the ports for every service. -->
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Observability/Observability.csproj" />
  </ItemGroup>

</Project>
