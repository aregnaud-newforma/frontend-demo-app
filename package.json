{
  "name": "frontend-demo-app",
  "private": true,
  "version": "1.0.0",
  "description": "Practical testing-trophy example: static (oxlint/tsc) + unit (Vitest) + integration (Vitest Browser Mode/MSW) + E2E (Playwright).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "evals": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning evals/run.ts",
    "evals:online": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning evals/online.ts",
    "api:start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/api.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "oxlint && oxfmt --check && tsc --noEmit && tsc -p tsconfig.app.json",
    "browsers:install": "playwright install --with-deps chromium",
    "postinstall": "msw init public/ --save"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 114",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@faker-js/faker": "^9.3.0",
    "@langfuse/client": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@msw/data": "^1.1.7",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@playwright/test": "^1.49.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "enforce-unique": "^1.3.0",
    "fishery": "^2.4.0",
    "msw": "^2.7.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.49.1",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
