{
  // The SHIPPED app, and only it - the narrowing half of the pair described in
  // ./tsconfig.json. `yarn build` compiles against this rather than the wide
  // config, so the bundle is still checked on its own terms: with the test
  // files out of the program and `types: []` shutting off the ambient vitest
  // and node declarations, an app file that reached for `expect`, or imported
  // a mock, or used `process.env`, is an error here even though the editor -
  // which uses the wide config - would have said nothing.
  //
  // Deliberately NOT named tsconfig.*.json by accident: the editor only ever
  // discovers files named exactly `tsconfig.json`, so this one is reached by
  // `tsc -p` and nothing else. That is the point - it is a gate, not the
  // project anyone edits in.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `vite/client` and nothing else: the app genuinely depends on it (it is
    // what makes `import "./global.css"` resolve), while the vitest and node
    // declarations stay out - which is the whole point of this config.
    "types": ["vite/client"],
    "noEmit": true
  },
  // The remote declarations too: `account/pages` in apps/shell/src/routes.tsx
  // is a name the federation runtime resolves, and apps/shell/types/remotes.d.ts
  // is the only place TypeScript can learn what it points at. Not the rest of
  // types/ - the postcss declaration serves the config files, which are out of
  // this program.
  //
  // packages/testing is excluded wholesale rather than by a test-file pattern:
  // it is the harness, none of it ships, and it is the one package with no
  // production surface at all.
  "include": ["apps", "packages/tokens", "apps/shell/types/remotes.d.ts"],
  "exclude": [
    // Build tooling, not shipped code - and it reaches the root config files,
    // which need the `types/` declarations this program deliberately drops.
    "apps/*/vite.config.ts",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "apps/*/src/app-under-test.ts",
    "packages/testing/**",
    // React Native, checked by its own config - apps/mobile/tsconfig.json
    // extends expo/tsconfig.base, whose lib and jsx settings are not this
    // program's. `yarn verify` runs `tsc -p apps/mobile` beside this one.
    "apps/mobile/**"
  ]
}
