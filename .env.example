# Langfuse tracing for the account API (server/instrumentation.ts).
#
# Copy to `.env` and fill in a project's keys to have `yarn api:start` send one
# trace per request. Both keys must be set or tracing stays off - the server
# runs and the E2E tier passes either way, so nothing here is required.
#
# Keys come from the Langfuse project under Settings -> API Keys. Free cloud
# account: https://langfuse.com/cloud
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."

# The Langfuse data region, or a self-hosted URL. EU is the default region:
# US https://us.cloud.langfuse.com, Japan https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Which environment traces are filed under. Defaults to "development".
# LANGFUSE_TRACING_ENVIRONMENT="development"
