{
  "compilerOptions": {
    // ES2023, because that is what the browsers in package.json `browserslist`
    // actually have - `toSorted` shipped in Chrome 110 and Safari 16, both below
    // the floor. Anything newer is deliberately withheld: `lib` is the only
    // thing that stops an API the floor lacks from being written, since nothing
    // in the build polyfills one (see vite.config.ts) and `vite dev` runs
    // esnext, so a Set method would work here and throw on Safari 16.4. Raising
    // this means raising the floor first, in package.json and vite.config.ts.
    // `.oxlintrc.json` `env` says the same thing for the linter's globals.
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    // No `paths`, and none needed: every cross-folder import is a workspace
    // package now (`@demo/account/mocks/db-utils`), which yarn resolves through
    // node_modules and TypeScript reads out of that package's `exports`. The
    // list used to be written twice - here and in alias.ts - and keeping the
    // two in step was the standing cost this migration removed. Playwright,
    // which read the mapping straight from this file and had no alias config of
    // its own, now resolves the same way everything else does.
    // Restricted on purpose: `types` is the ambient half of the program, and
    // these are what the code needs. `vitest/browser` is what teaches
    // TypeScript about `expect.element(...)` and the DOM matchers - without it
    // every assertion in an integration test is an error on a real API.
    // `vite/client` declares the asset modules, so `import "./global.css"` has
    // something to resolve to - TypeScript 7 rejects a side-effect import of a
    // module it knows nothing about, where 5 let it pass.
    "types": ["vitest/globals", "vitest/browser", "node", "vite/client"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // EVERY TypeScript file in the repo, deliberately.
  //
  // This file used to cover src/ minus the tests, which left the tests, the
  // e2e specs and the API server belonging to NO project - and a file in no
  // project is resolved by the editor in an INFERRED one, on default options.
  // no `types`, so `expect.element` is not a function. None of it
  // showed up in CI either, because `tsc` was never asked to compile those
  // files: `yarn verify` passed on a program that did not contain them.
  //
  // An editor picks a file's project by walking up to the nearest file NAMED
  // tsconfig.json - `tsconfig.*.json` is invisible to that search, and test
  // files sit inside src/ next to the app files, so no amount of splitting by
  // folder can reach them. The one arrangement that does is this: the widest
  // config is the discoverable one. tsconfig.app.json then narrows BACK DOWN
  // to the shipped app for the build (see the `build` script), which is the
  // check the old exclude list was really there to make.
  "include": [
    "apps",
    "packages",
    "server",
    "e2e",
    "evals",
    "types",
    "vitest.setup.ts",
    "*.config.ts"
  ],
  // The one exception to "every TypeScript file in the repo", and the reason it
  // is an exception rather than a hole: apps/mobile is React Native. Its lib is
  // not the DOM, its `types` are jest and expo rather than vitest and vite, and
  // its JSX comes from react-native's own declarations - a program that held
  // both would have to widen until neither half was really checked. It has its
  // own tsconfig.json (extending expo/tsconfig.base), which is what the editor
  // finds by walking up from a file inside it, and `yarn verify` runs it.
  "exclude": ["apps/mobile"]
}
